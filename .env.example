# API
# 127.0.0.1 par défaut : le service est publié par Nginx, pas directement.
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=change_me

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/address_validator
REDIS_URL=redis://localhost:6379/0

# Fournisseur de validation
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token

# Paiement x402
CDP_API_KEY_ID=your_cdp_key_id
CDP_API_KEY_SECRET=your_cdp_key_secret
CDP_WALLET_ADDRESS=your_wallet_address
X402_PRICE=0.02

# Recette contre revenu (D40) — un essai de recette n'est pas du revenu client.
# `true` marque `test_mode` les paiements enregistrés : ils restent au registre
# (traçabilité) mais sont exclus de `real_revenue_usdc` / `real_validations_paid`
# publiés par /metrics/revenue ; `total_*` les inclut toujours. Laisser `false`
# en production, passer à `true` le temps d'un test de bout en bout payé.
TEST_MODE=false
# Seuil de rattrapage (UTC, ISO 8601) lu par `scripts/migrate_test_mode.py` :
# toute transaction antérieure à cet instant est un essai de recette — les deux
# validations payées du 11/10/2026 (06:30 et 06:56 UTC) sont de ceux-là.
TEST_MODE_CUTOFF_UTC=2026-10-11T12:00:00+00:00

# Vérification on-chain du paiement (D27) — optionnelle, désactivée par défaut :
# la preuve HMAC (D15) suffit. `true` exige en plus, sur Base, un transfert USDC
# confirmé vers CDP_WALLET_ADDRESS pour au moins X402_PRICE (app/onchain.py).
X402_ONCHAIN_VERIFY=false
BASE_RPC_URL=https://mainnet.base.org
X402_USDC_CONTRACT=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
X402_MIN_CONFIRMATIONS=1

# Paiement x402 standard (D34-D36, app/x402.py) — protocole v1 : le client paie
# avec l'en-tête X-PAYMENT et le service répond X-PAYMENT-RESPONSE après
# règlement. Le domaine EIP-712 (`name`/`version`) est celui du contrat USDC :
# le vérifier on-chain avec `scripts/test_x402_payment.py --check-domain` avant
# toute mise en vente. Une valeur fausse ferait refuser toute signature honnête.
X402_NETWORK=base
X402_CHAIN_ID=8453
X402_DOMAIN_NAME=USD Coin
X402_DOMAIN_VERSION=2
# Facilitateur : /verify (droit de payer) puis /settle (encaissement réel).
# Défaut = facilitateur Coinbase (CDP), authentifié par un JWT signé avec
# CDP_API_KEY_ID / CDP_API_KEY_SECRET.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_VERIFY=true
# `true` (défaut) : ne rendre le service qu'après un règlement réussi. Mettre
# `false` reviendrait à livrer contre une autorisation non encaissée : à ne
# jamais faire en production.
X402_REQUIRE_SETTLEMENT=true
# URLs publiques citées dans `accepts[].resource`, dans la carte MCP et dans les
# fichiers d'annuaire : elles doivent être celles réellement servies.
PUBLIC_BASE_URL=https://kder-ai.com
MCP_PUBLIC_URL=https://kder-ai.com/mcp

# Journal des tentatives non payées (D30) — découvrabilité et abus.
# Chaque 402 écrit une ligne JSONL de métadonnées de requête. L'adresse validée
# n'est jamais journalisée. Chemin vide = journald seul, aucune écriture disque.
DISCOVERY_LOG_ENABLED=true
DISCOVERY_LOG_PATH=/var/log/address-validator/discovery.jsonl
# false (défaut) = IP pseudonymisée (sha256 + sel) ; true = IP en clair, pour une
# enquête d'abus limitée dans le temps, à justifier (PRIVACY.md §3).
DISCOVERY_LOG_RAW_IP=false
# Sel dédié. Vide = dérivé de API_SECRET_KEY (dépannage), déconseillé en production.
DISCOVERY_LOG_SALT=change_me_salt
# Purge appliquée par scripts/daily_report.sh : conservation annoncée = appliquée.
DISCOVERY_LOG_RETENTION_DAYS=30

# Tableau de bord d'exploitation (D32). Mot de passe vide = endpoint *fermé*
# (503). Ne jamais committer de mot de passe réel : le renseigner dans le .env
# du VPS uniquement.
DASHBOARD_USER=kder
DASHBOARD_PASSWORD=

# CRM de prospection (Tâche 7). Chemin de la base SQLite de prospection, tenue par
# `prospection/scripts/*.py` sur le poste. Ce dossier n'est pas déployé avec le
# service : laisser la valeur par défaut, et `/prospection` répond `503` sur le
# VPS. Même garde que /dashboard : DASHBOARD_PASSWORD vide = route fermée.
PROSPECTION_DB=prospection/data/prospects.db

# Environnement
ENVIRONMENT=development
LOG_LEVEL=INFO
