# API
# 127.0.0.1 par défaut : le service est publié par Nginx, pas directement.
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=change_me

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/address_validator
REDIS_URL=redis://localhost:6379/0

# Fournisseur de validation
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token

# Paiement x402
CDP_API_KEY_ID=your_cdp_key_id
CDP_API_KEY_SECRET=your_cdp_key_secret
CDP_WALLET_ADDRESS=your_wallet_address
X402_PRICE=0.02

# Recette contre revenu (D40) — un essai de recette n'est pas du revenu client.
# `true` marque `test_mode` les paiements enregistrés : ils restent au registre
# (traçabilité) mais sont exclus de `real_revenue_usdc` / `real_validations_paid`
# publiés par /metrics/revenue ; `total_*` les inclut toujours. Laisser `false`
# en production, passer à `true` le temps d'un test de bout en bout payé.
# Depuis W1, `true` ouvre *aussi* la voie HMAC héritée sans confirmation on-chain
# (app/payment.py) : c'est ce qui permet à la recette de l'exploitant de se
# dérouler sans payer 0,02 USDC réels à chaque contrôle — et c'est pour cela que
# les lignes écrites sont marquées `test_mode`.
TEST_MODE=false
# Seuil de rattrapage (UTC, ISO 8601) lu par `scripts/migrate_test_mode.py` :
# toute transaction antérieure à cet instant est un essai de recette — les deux
# validations payées du 11/10/2026 (06:30 et 06:56 UTC) sont de ceux-là.
TEST_MODE_CUTOFF_UTC=2026-10-11T12:00:00+00:00

# Vérification on-chain du paiement (D27, durcissement W1) — **doit rester à
# `true` en production.** La preuve HMAC (D15) n'est qu'un secret partagé :
# forgée par qui connaît API_SECRET_KEY, elle donnait un 200 sans encaissement.
# `true` exige en plus, sur Base, un transfert USDC confirmé vers
# CDP_WALLET_ADDRESS pour au moins X402_PRICE (app/onchain.py) ; tout échec vaut
# 402. Le défaut du code est `true` : une variable oubliée ne rouvre donc pas le
# service contre une preuve synthétique (fail-open mesuré le 12/10/2026).
# Ne passer à `false` QUE pour un test local **avec TEST_MODE=true** : hors
# recette déclarée, `false` fait refuser *toute* preuve à secret partagé
# (app/payment.py, W1).
X402_ONCHAIN_VERIFY=true
BASE_RPC_URL=https://mainnet.base.org
X402_USDC_CONTRACT=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
X402_MIN_CONFIRMATIONS=1

# Paiement x402 standard (D34-D36, app/x402.py) — protocole v1 : le client paie
# avec l'en-tête X-PAYMENT et le service répond X-PAYMENT-RESPONSE après
# règlement. Le domaine EIP-712 (`name`/`version`) est celui du contrat USDC :
# le vérifier on-chain avec `scripts/test_x402_payment.py --check-domain` avant
# toute mise en vente. Une valeur fausse ferait refuser toute signature honnête.
X402_NETWORK=base
X402_CHAIN_ID=8453
X402_DOMAIN_NAME=USD Coin
X402_DOMAIN_VERSION=2
# Facilitateur : /verify (droit de payer) puis /settle (encaissement réel).
# Défaut = facilitateur Coinbase (CDP), authentifié par un JWT signé avec
# CDP_API_KEY_ID / CDP_API_KEY_SECRET.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_VERIFY=true
# `true` (défaut) : ne rendre le service qu'après un règlement réussi. Mettre
# `false` reviendrait à livrer contre une autorisation non encaissée : à ne
# jamais faire en production.
X402_REQUIRE_SETTLEMENT=true
# URLs publiques citées dans `accepts[].resource`, dans la carte MCP et dans les
# fichiers d'annuaire : elles doivent être celles réellement servies.
PUBLIC_BASE_URL=https://kder-ai.com
MCP_PUBLIC_URL=https://kder-ai.com/mcp

# Journal des tentatives non payées (D30) — découvrabilité et abus.
# Chaque 402 écrit une ligne JSONL de métadonnées de requête. L'adresse validée
# n'est jamais journalisée. Chemin vide = journald seul, aucune écriture disque.
DISCOVERY_LOG_ENABLED=true
DISCOVERY_LOG_PATH=/var/log/address-validator/discovery.jsonl
# false (défaut) = IP pseudonymisée (sha256 + sel) ; true = IP en clair, pour une
# enquête d'abus limitée dans le temps, à justifier (PRIVACY.md §3).
DISCOVERY_LOG_RAW_IP=false
# Sel dédié. Vide = dérivé de API_SECRET_KEY (dépannage), déconseillé en production.
DISCOVERY_LOG_SALT=change_me_salt
# Purge appliquée par scripts/daily_report.sh : conservation annoncée = appliquée.
DISCOVERY_LOG_RETENTION_DAYS=30

# Tableau de bord d'exploitation (D32). Mot de passe vide = endpoint *fermé*
# (503). Ne jamais committer de mot de passe réel : le renseigner dans le .env
# du VPS uniquement.
DASHBOARD_USER=kder
DASHBOARD_PASSWORD=

# Inscription self-service (D44). Plafond exigé par la spec : 5 tentatives par IP
# et par heure (Redis ; repli local compté si Redis est absent). Si un vrai
# client est bloqué, élever la valeur ici puis redémarrer le service.
SIGNUP_RATE_LIMIT_PER_HOUR=5
# Essai gratuit : durée **publiée** sur /pricing (« 14 jours ») et **appliquée**
# à l'inscription. Modifier l'une sans l'autre ferait mentir la page.
TRIAL_DAYS=14
# Essais gratuits du formulaire public /validate-form (élément 3) : 10 par IP et
# par 24 h.
VALIDATE_FORM_RATE_LIMIT_PER_DAY=10


# Espace client (D62, D63). Durée d'une session, échecs avant blocage, durée du
# blocage : les trois valeurs sont **écrites** sur la page de connexion.
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Mot de passe oublié : durée du lien envoyé par mail (usage unique) et plafond
# de demandes par IP et par heure.
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_PER_HOUR=5
# Envoi du mail de mot de passe oublié (Brevo, Zoho…). SMTP_HOST vide = aucun mail
# ne part : la page répond pareil, et un avertissement est journalisé. Port 587 :
# STARTTLS ; port 465 : TLS direct. SMTP_FROM vide = CONTACT_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Suivi d'audience et d'usage (D67). Base des pays DB-IP Lite (CC BY 4.0), posée
# et tenue à jour chaque mois par scripts/maj_geoip.sh ; fichier absent = pays
# inconnu, jamais une erreur. L'adresse IP n'est jamais gardée. Les lignes de
# page_visits et api_calls sont effacées après AUDIENCE_RETENTION_DAYS jours.
GEOIP_DB_PATH=/var/lib/address-validator/dbip-country.mmdb
AUDIENCE_RETENTION_DAYS=400

# Coûts d'exploitation (D68), lus par le tableau de bord : euros par mois pour le
# serveur, le forfait du fournisseur d'adresses et l'envoi de mails ; dollars par
# appel au fournisseur s'il facture à l'appel. Tous à 0 = coûts non renseignés,
# le résultat du mois n'est pas calculé (pas de faux bénéfice).
COST_SERVER_EUR=0
COST_SMARTY_EUR=0
COST_SMARTY_PER_CALL_USD=0
COST_MAIL_EUR=0


# Pages publiques de la campagne commerciale (D43 : /pricing, puis /signup et
# /validate-form). Sans effet depuis le dessin validé des tarifs (six langues) :
# /pricing n'a plus de section témoignages, quelle que soit la valeur. Gardée
# pour qu'un .env existant reste valide ; de vrais témoignages demanderaient un
# nouveau gabarit, validé comme les autres.
PRICING_SHOW_TESTIMONIALS=false


# CRM de prospection (Tâche 7). Chemin de la base SQLite de prospection, tenue par
# `prospection/scripts/*.py` sur le poste. Ce dossier n'est pas déployé avec le
# service : laisser la valeur par défaut, et `/prospection` répond `503` sur le
# VPS. Même garde que /dashboard : DASHBOARD_PASSWORD vide = route fermée.
PROSPECTION_DB=prospection/data/prospects.db

# Environnement
ENVIRONMENT=development
LOG_LEVEL=INFO
