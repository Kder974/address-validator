# --- adresses IP ---
# (le rate limiting par IP est décrit dans SECURITY.md ; à brancher via le
#  reverse proxy Nginx ou un middleware — voir DECISIONS.md D21)
#
# --- cache / artefacts ---
.pytest_cache/
__pycache__/
*.py[cod]
.coverage
htmlcov/
.venv/
venv/

# --- secrets / environnement ---
# `.env.*` couvre les fichiers par usage (`.env.smtp` du script d'envoi, `.env.local`)
# et `.env.example` reste l'exception : un secret vit sur le poste, jamais ici.
.env
.env.*
*.env
!.env.example

# --- journaux ---
*.log
logs/
*.err
# Journal de decouverte (D30) : donnees d'exploitation, jamais dans le depot.
*.jsonl

# --- divers ---
.DS_Store
diag_*.txt

# --- captures de session / base de démonstration ---
# Sorties de commandes et base SQLite jetable (`scripts/demo_local.py`) :
# des mesures locales, jamais du contenu de dépôt.
.pytest-out.txt
.oracles-out.txt
.tmp_*
demo.sqlite*

# Carte du projet produite par le skill graphify (.claude/skills/graphify)
graphify-out/
